// The te terminal engine of nxterm (https://github.com/nxterm/nxterm),
// vendored for the benchmark: package te and the packages it imports, under
// nxterm's module path so the sources read as upstream's. See README.md.
module nx

go 1.25.0

require (
	github.com/rivo/uniseg v0.4.7
	golang.org/x/text v0.35.0
)
